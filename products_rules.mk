#ifndef __PRODUCT_RULE_MAKE__

__PRODUCT_RULE_MAKE__ := 1



#include vot_config.mk

#[STANDARD,  MANUAL,CTYPE_DSW]
CUSTOMER_TYPE ?= STANDARD

#[FPGA, ASIC, VS ]
HARD_PLATFORM_TYPE ?= ASIC

#[VOT, RTD, VOT_WLP, MANUAL ]
DETECTOR_TYPE?=VOT

#[RES_640_512, RES_384_288 ,RES_1280_1024, RES_MANUAL ]
RESOLUTION_TYPE ?= RES_640_512

#[CVBS, LIBUSB, UVC, MIPI, MANUAL ]
VIDEO_OUTPUT_TYPE ?= MANUAL


#[INFRARED_IMAGING_TYPE, INFRARED_THERMOMETRY_TYPE , MANUAL ]
FUNCTION_TYPE ?= MANUAL

#[PRIME_LENS_TYPE, FOCUS_LENS_POTENTIOMETER,ZOOM_LENS_POTENTIOMETER,FOCUS_LENS_ENCODER,ZOOM_LENS_ENCODER, MANUAL]
FOCUS_TYPE ?= MANUAL

#硬件接口板类型 [UAD3_Lite: 两块接口板； UAD3: 三块接口板, MANUAL:手动指定]
HARD_BOARD_PORT_TYPE ?= UAD3


CUSTOMER_ID ?= 000
HARD_PLATFORM_ID ?= 1
DETECTOR_ID ?= 0
RESOLUTION_ID ?= 0
VIDEO_OUTPUT_ID ?= 0
FUNCTION_ID ?= 0
FOCUS_ID ?= 0
EXT_FUNCTION_ID ?= 000
TEST_VERSION_ID ?= 009

PRODUCTION_NAME ?= UAD3



ifeq ($(strip $(CUSTOMER_TYPE)),STANDARD)
	CUSTOMER_ID := 000
else ifeq ($(strip $(CUSTOMER_TYPE)),MANUAL)
	CUSTOMER_ID := 000
else ifeq ($(strip $(CUSTOMER_TYPE)),CTYPE_DSW) #深圳鼎深微-UAD3机芯" 定制
	CUSTOMER_ID := 002
else
	CUSTOMER_ID := 000
endif

ifeq ($(strip $(HARD_PLATFORM_TYPE)),FPGA)
	HARD_PLATFORM_ID := 0
else ifeq ($(strip $(HARD_PLATFORM_TYPE)),ASIC)
	HARD_PLATFORM_ID := 1
else ifeq ($(strip $(HARD_PLATFORM_TYPE)),VS)
	HARD_PLATFORM_ID := 2
else 
	HARD_PLATFORM_ID := 1
endif


# $(info DETECTOR_ID $(DETECTOR_ID) )
# $(info DETECTOR_TYPE $(DETECTOR_TYPE) )

ifeq ($(DETECTOR_TYPE),VOT)
	DETECTOR_ID := 0
else ifeq ($(DETECTOR_TYPE),RTD)
	DETECTOR_ID := 1
else ifeq ($(DETECTOR_TYPE),VOT_WLP)
	DETECTOR_ID := 2
else ifeq ($(DETECTOR_TYPE),MANUAL)
	DETECTOR_ID := 3
else 
	DETECTOR_ID := 0
	$(info defautl $(DETECTOR_ID) )
endif
$(info DETECTOR_ID $(DETECTOR_ID) )



ifeq ($(RESOLUTION_TYPE),RES_640_512)
	RESOLUTION_ID := 0
	RESOLUTION_NAME := 640
else ifeq ($(RESOLUTION_TYPE),RES_384_288)
	RESOLUTION_ID := 1
	RESOLUTION_NAME := 384
else ifeq ($(RESOLUTION_TYPE),RES_MANUAL)
	RESOLUTION_ID := 2
	RESOLUTION_NAME := RES_MANUAL
else ifeq ($(RESOLUTION_TYPE),RES_1280_1024)
	RESOLUTION_ID := 3
	RESOLUTION_NAME := 1280
else 
	RESOLUTION_ID := 0
	RESOLUTION_NAME := 640
endif
$(info RESOLUTION_TYPE $(RESOLUTION_TYPE) )
$(info RESOLUTION_ID $(RESOLUTION_ID) )

ifeq ($(VIDEO_OUTPUT_TYPE),CVBS)
	VIDEO_OUTPUT_ID := 0
else ifeq ($(VIDEO_OUTPUT_TYPE),LIBUSB)
	VIDEO_OUTPUT_ID := 1
else ifeq ($(VIDEO_OUTPUT_TYPE),UVC)
	VIDEO_OUTPUT_ID := 2
else ifeq ($(VIDEO_OUTPUT_TYPE),MIPI)
	VIDEO_OUTPUT_ID := 3
else ifeq ($(VIDEO_OUTPUT_TYPE),MANUAL)
	VIDEO_OUTPUT_ID := 4
else 
	VIDEO_OUTPUT_ID := 0
endif

$(info VIDEO_OUTPUT_TYPE $(VIDEO_OUTPUT_TYPE) )
$(info VIDEO_OUTPUT_ID $(VIDEO_OUTPUT_ID) )

ifeq ($(FUNCTION_TYPE),INFRARED_IMAGING_TYPE)
	FUNCTION_ID := 0
else ifeq ($(FUNCTION_TYPE),INFRARED_THERMOMETRY_TYPE)
	FUNCTION_ID := 1
else ifeq ($(FUNCTION_TYPE),MANUAL)
	FUNCTION_ID := 2
else 
	FUNCTION_ID := 0
endif

$(info FUNCTION_ID $(FUNCTION_ID) )
$(info FUNCTION_TYPE $(FUNCTION_TYPE) )


ifeq ($(FOCUS_TYPE),PRIME_LENS_TYPE)
	FOCUS_ID := 0
else ifeq ($(FOCUS_TYPE),FOCUS_LENS_POTENTIOMETER) #调焦机芯（电位器）
	FOCUS_ID := 1
else ifeq ($(FOCUS_TYPE),ZOOM_LENS_POTENTIOMETER) #变焦机芯（电位器）
	FOCUS_ID := 2
else ifeq ($(FOCUS_TYPE),FOCUS_LENS_ENCODER) #调焦机芯（编码器）
	FOCUS_ID := 3
else ifeq ($(FOCUS_TYPE),ZOOM_LENS_ENCODER) #变焦机芯（编码器）
	FOCUS_ID := 4
else ifeq ($(FOCUS_TYPE),MANUAL)
	FOCUS_ID := 5
else 
	FOCUS_ID := 0
endif

$(info FOCUS_TYPE $(FOCUS_TYPE) )
$(info FOCUS_ID $(FOCUS_ID) )

ifeq ($(HARD_BOARD_PORT_TYPE),UAD3_Lite)
	EXT_FUNCTION_ID = 001
else ifeq ( $(HARD_BOARD_PORT_TYPE),UAD3)
	EXT_FUNCTION_ID = 000
else ifeq ($(HARD_BOARD_PORT_TYPE),UAW)#wlp
	EXT_FUNCTION_ID = 200
else ifeq ($(HARD_BOARD_PORT_TYPE),UAW_Lite)#17x17 陶封 wlp
	EXT_FUNCTION_ID = 201
else ifeq ($(HARD_BOARD_PORT_TYPE),NORMAL)
	EXT_FUNCTION_ID = 000
else ifeq ($(HARD_BOARD_PORT_TYPE),MANUAL)
	EXT_FUNCTION_ID = 300
endif


$(info HARD_BOARD_PORT_TYPE $(HARD_BOARD_PORT_TYPE) )
$(info EXT_FUNCTION_ID $(EXT_FUNCTION_ID) )
$(info DETECTOR_ID $(DETECTOR_ID) )
$(info DETECTOR_TYPE $(DETECTOR_TYPE) )
$(info CUSTOMER_TYPE $(CUSTOMER_TYPE) )

MAJOR_VERSION= 1
MINOR_VERSION = 1
BUILD_VERSION = 01
FIRMWARE_SOFT_VERSION := 1.2.0

FIRMWARE_VERSION ?= $(CUSTOMER_ID).$(FIRMWARE_SOFT_VERSION).$(HARD_PLATFORM_ID)$(DETECTOR_ID)$(RESOLUTION_ID)$(VIDEO_OUTPUT_ID)$(FUNCTION_ID)$(FOCUS_ID).$(EXT_FUNCTION_ID).$(TEST_VERSION_ID)
$(info  $(FIRMWARE_VERSION) )

#000.1.0.01.100000.000.000
#客户编码（3位）.版本号（4位）.功能ID（6位）拓展功能ID（3位）.测试版本ID（3位）

ifeq ($(HARD_BOARD_PORT_TYPE),MANUAL)
	FIRMWARE_NAME_PREFIX ?= VOT_All_Platform_V
else
	FIRMWARE_NAME_PREFIX ?= VOT_$(HARD_BOARD_PORT_TYPE)_$(RESOLUTION_NAME)_V
endif


CLEAN_FIRMWARE_NAME_PREFIX ?= $(strip $(FIRMWARE_NAME_PREFIX))$(FIRMWARE_VERSION)


export FIRMWARE_VERSION
export FIRMWARE_NAME_PREFIX
export CLEAN_FIRMWARE_NAME_PREFIX


#endif
