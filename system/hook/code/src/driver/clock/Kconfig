menu "Clock Configuration"

choice
	prompt "Clock select"
	default CLKM_NULL

config CLKM_NULL
	bool "No clock manager"


config CLKM_T10X
	bool "T10x clock manager"

endchoice

choice
	prompt "PLL mode select"
	default PLL_FPGA_RELEASE

config PLL_FPGA_DEBUG
	bool "PLL debug for FPGA"

config PLL_FPGA_RELEASE
	bool "PLL release for FPGA"

config PLL_ASIC_DEBUG
	bool "PLL debug for ASIC"

config PLL_ASIC_RELEASE
	bool "PLL release for ASIC"

endchoice


endmenu
