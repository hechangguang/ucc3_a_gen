menu "EFUSE Configuration"

choice
	prompt "EFUSE select"
	default EFUSE_NULL

config EFUSE_NULL
	bool "No efuse device"

config EFUSE_V100
	bool "EFUSE ctrl v100"

endchoice

config EFUSE_REG_ADDR
	hex "Efuse ctrl reg addr"
	default 0x00280000
	help
		if set to 0, the ctrl disable

config EFUSE_NOT_HAL
	bool "Not HAL driver"
	default n


endmenu
